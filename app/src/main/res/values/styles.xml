<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Opening Theme -->
    <style name="Base.OpeningTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryVariant</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="android:windowBackground">@color/background_color</item>
        <item name="android:navigationBarColor">@color/colorPrimaryDark</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
    </style>

    <!-- Light Theme -->
    <style name="Base.LightTheme" parent="Base">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorSecondary</item>
        <item name="android:windowBackground">@color/background_color</item>
        <item name="android:navigationBarColor">@color/colorPrimaryDark</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
    </style>

    <!-- Dark Theme -->
    <style name="Base.DarkTheme" parent="Base">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorSecondary</item>
        <item name="android:windowBackground">@color/background_color</item>
        <item name="android:navigationBarColor">@color/colorPrimaryDark</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
    </style>

    <!-- Base Theme -->
    <style name="Base" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorSecondary</item>
        <item name="android:windowBackground">@color/background_color</item>
        <item name="android:navigationBarColor">@color/colorPrimaryDark</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="colorControlActivated">@color/colorSecondary</item>
        <item name="colorControlNormal">@color/colorOnSurface</item>
        <item name="colorControlActivated">@color/colorSecondary</item>
        <item name="colorControlNormal">@color/colorOnSurface</item>
        <item name="android:windowBackground">@color/background_color</item>
        <item name="android:navigationBarColor">@color/colorPrimaryDark</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:windowBackground">@color/background_color</item>
    </style>

    <!-- Light Theme -->
    <style name="LightTheme" parent="Base.LightTheme" />
    <style name="DarkTheme" parent="Base.DarkTheme" />

    <!-- Opening Theme -->
    <style name="OpeningTheme" parent="Base.OpeningTheme" />
</resources>
